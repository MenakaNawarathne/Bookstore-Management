@page "/Error"
@attribute [Authorize]

<PageTitle>Error</PageTitle>

<div class="text-center py-5">
    <i class="bi bi-exclamation-triangle-fill text-danger" style="font-size:4rem;"></i>
    <h2 class="mt-3">An error occurred</h2>
    <p class="text-muted">Sorry, an unexpected error has occurred. Please try refreshing the page.</p>
    <a href="/" class="btn btn-primary mt-2"><i class="bi bi-house me-1"></i>Go Home</a>
</div>
