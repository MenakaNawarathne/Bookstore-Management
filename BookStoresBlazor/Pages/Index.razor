@page "/"
@attribute [Authorize]
@inject IBookStoresService BookService
@inject OrderService OrderSvc
@inject CustomAuthStateProvider AuthProvider
@inject NavigationManager Nav

<PageTitle>Dashboard — BookStores</PageTitle>

@if (_loading)
{
    <div class="text-center py-5">
        <div class="spinner-border text-primary" style="width:3rem;height:3rem;" role="status"></div>
        <p class="mt-3 text-muted">Loading dashboard metrics...</p>
    </div>
}
else
{
    <div class="d-flex flex-wrap justify-content-between align-items-center mb-4 gap-2">
        <div class="d-flex align-items-center">
            <i class="bi bi-speedometer2 fs-3 me-3 text-primary"></i>
            <div>
                <h2 class="mb-0 fw-bold">@(_user?.Role == "Customer" ? "Customer Portal" : _user?.Role == "StoreStaff" ? "Store Staff Operations" : "Executive Management")</h2>
                <p class="text-muted mb-0">Welcome back, @(_user?.FirstName ?? _user?.Username)</p>
            </div>
        </div>
        <div>
            <span class="badge @GetRoleBadgeClass(_user?.Role) px-3 py-2 fs-6">
                <i class="bi @GetRoleIcon(_user?.Role) me-1"></i>@_user?.Role Account
            </span>
        </div>
    </div>

    @* ══════════════════════════════════════════════════════════════════════ *@
    @* 1. CUSTOMER DASHBOARD                                                *@
    @* ══════════════════════════════════════════════════════════════════════ *@
    @if (_user?.Role == "Customer")
    {
        <div class="row g-4 mb-4">
            <div class="col-12 col-md-4">
                <div class="card border-0 shadow-sm text-center p-4 h-100">
                    <div class="bg-primary bg-opacity-10 rounded-circle p-3 d-inline-block mx-auto mb-2">
                        <i class="bi bi-shop text-primary" style="font-size: 2.5rem;"></i>
                    </div>
                    <h5 class="fw-bold mt-2">Book Catalogue</h5>
                    <p class="text-muted small">Search books across genres, inspect synopsis, and check stock availability.</p>
                    <a href="/shop" class="btn btn-primary mt-auto">Browse Books</a>
                </div>
            </div>
            <div class="col-12 col-md-4">
                <div class="card border-0 shadow-sm text-center p-4 h-100">
                    <div class="bg-success bg-opacity-10 rounded-circle p-3 d-inline-block mx-auto mb-2">
                        <i class="bi bi-cart3 text-success" style="font-size: 2.5rem;"></i>
                    </div>
                    <h5 class="fw-bold mt-2">My Shopping Cart</h5>
                    <p class="text-muted small">Review items ready for checkout and review instant subtotal calculations.</p>
                    <a href="/cart" class="btn btn-outline-success mt-auto">Open Shopping Cart</a>
                </div>
            </div>
            <div class="col-12 col-md-4">
                <div class="card border-0 shadow-sm text-center p-4 h-100">
                    <div class="bg-info bg-opacity-10 rounded-circle p-3 d-inline-block mx-auto mb-2">
                        <i class="bi bi-bag-check text-info" style="font-size: 2.5rem;"></i>
                    </div>
                    <h5 class="fw-bold mt-2">Order Tracking</h5>
                    <p class="text-muted small">Check real-time fulfillment timelines for your current and past bookstore orders.</p>
                    <a href="/my-orders" class="btn btn-outline-info mt-auto">View My Orders</a>
                </div>
            </div>
        </div>
    }

    @* ══════════════════════════════════════════════════════════════════════ *@
    @* 2. STORE STAFF DASHBOARD                                             *@
    @* ══════════════════════════════════════════════════════════════════════ *@
    else if (_user?.Role == "StoreStaff")
    {
        <div class="row g-3 mb-4">
            <div class="col-6 col-lg-3">
                <div class="card border-0 shadow-sm p-3">
                    <div class="text-muted small text-uppercase">Total Orders</div>
                    <div class="fs-2 fw-bold text-dark">@_stats.TotalOrders</div>
                    <span class="small text-muted"><i class="bi bi-receipt me-1"></i>Lifetime customer orders</span>
                </div>
            </div>
            <div class="col-6 col-lg-3">
                <div class="card border-0 shadow-sm p-3 border-start border-warning border-4">
                    <div class="text-muted small text-uppercase">Pending Orders</div>
                    <div class="fs-2 fw-bold text-warning">@_stats.PendingOrders</div>
                    <span class="small text-muted">Awaiting confirmation</span>
                </div>
            </div>
            <div class="col-6 col-lg-3">
                <div class="card border-0 shadow-sm p-3 border-start border-info border-4">
                    <div class="text-muted small text-uppercase">Processing / Shipped</div>
                    <div class="fs-2 fw-bold text-info">@(_stats.ProcessingOrders + _stats.ShippedOrders)</div>
                    <span class="small text-muted">In preparation or transit</span>
                </div>
            </div>
            <div class="col-6 col-lg-3">
                <div class="card border-0 shadow-sm p-3 border-start border-danger border-4">
                    <div class="text-muted small text-uppercase">Low Stock Alert</div>
                    <div class="fs-2 fw-bold text-danger">@_lowStockCount</div>
                    <span class="small text-muted">Items &le; 5 units remaining</span>
                </div>
            </div>
        </div>

        <div class="row g-4 mb-4">
            <div class="col-12 col-md-6">
                <div class="card border-0 shadow-sm h-100">
                    <div class="card-header bg-transparent fw-bold py-3">
                        <i class="bi bi-lightning-charge me-2 text-warning"></i>Staff Operational Shortcuts
                    </div>
                    <div class="card-body d-flex flex-column gap-2">
                        <a href="/staff/orders" class="btn btn-outline-primary d-flex align-items-center justify-content-between p-3">
                            <span><i class="bi bi-clipboard-check me-2"></i>Fulfill Customer Orders</span>
                            <span class="badge bg-primary rounded-pill">@_stats.PendingOrders Pending</span>
                        </a>
                        <a href="/staff/inventory" class="btn btn-outline-secondary d-flex align-items-center justify-content-between p-3">
                            <span><i class="bi bi-boxes me-2"></i>Manage Inventory &amp; Stock Levels</span>
                            <span class="badge bg-warning text-dark rounded-pill">@_lowStockCount Low Stock</span>
                        </a>
                        <a href="/shop" class="btn btn-outline-dark d-flex align-items-center justify-content-between p-3">
                            <span><i class="bi bi-shop me-2"></i>View Public Shop Front</span>
                            <i class="bi bi-arrow-right"></i>
                        </a>
                    </div>
                </div>
            </div>
            <div class="col-12 col-md-6">
                <div class="card border-0 shadow-sm h-100">
                    <div class="card-header bg-transparent fw-bold py-3">
                        <i class="bi bi-exclamation-triangle-fill me-2 text-danger"></i>Attention Required: Low Stock Items
                    </div>
                    <div class="card-body p-0">
                        @if (!_lowStockBooks.Any())
                        {
                            <div class="p-4 text-center text-muted">
                                <i class="bi bi-check-circle fs-3 text-success d-block mb-1"></i>
                                All book stock levels are currently healthy!
                            </div>
                        }
                        else
                        {
                            <ul class="list-group list-group-flush">
                                @foreach (var book in _lowStockBooks.Take(4))
                                {
                                    <li class="list-group-item d-flex justify-content-between align-items-center px-3 py-2">
                                        <div>
                                            <div class="fw-semibold small">@book.Title</div>
                                            <div class="text-muted small">@(book.Publisher?.PublisherName ?? "Independent")</div>
                                        </div>
                                        <span class="badge @(book.Stock == 0 ? "bg-danger" : "bg-warning text-dark")">
                                            @(book.Stock == 0 ? "Out of Stock" : $"{book.Stock} left")
                                        </span>
                                    </li>
                                }
                            </ul>
                        }
                    </div>
                </div>
            </div>
        </div>
    }

    @* ══════════════════════════════════════════════════════════════════════ *@
    @* 3. ADMINISTRATOR DASHBOARD                                           *@
    @* ══════════════════════════════════════════════════════════════════════ *@
    else if (_user?.Role == "Admin")
    {
        <div class="row g-3 mb-4">
            <div class="col-6 col-md-4 col-xl-2">
                <div class="card border-0 shadow-sm p-3">
                    <div class="text-muted small text-uppercase">Total Users</div>
                    <div class="fs-3 fw-bold text-dark">@_allUsers.Count</div>
                    <span class="small text-muted">@_allUsers.Count(u => u.Role == "Customer") customers</span>
                </div>
            </div>
            <div class="col-6 col-md-4 col-xl-2">
                <div class="card border-0 shadow-sm p-3">
                    <div class="text-muted small text-uppercase">Total Staff</div>
                    <div class="fs-3 fw-bold text-info">@_allUsers.Count(u => u.Role == "StoreStaff" || u.Role == "Admin")</div>
                    <span class="small text-muted">Staff + Admins</span>
                </div>
            </div>
            <div class="col-6 col-md-4 col-xl-2">
                <div class="card border-0 shadow-sm p-3">
                    <div class="text-muted small text-uppercase">Total Books</div>
                    <div class="fs-3 fw-bold text-primary">@_bookCount</div>
                    <span class="small text-muted">Across genres</span>
                </div>
            </div>
            <div class="col-6 col-md-4 col-xl-2">
                <div class="card border-0 shadow-sm p-3">
                    <div class="text-muted small text-uppercase">Orders Placed</div>
                    <div class="fs-3 fw-bold text-dark">@_stats.TotalOrders</div>
                    <span class="small text-muted">@_stats.PendingOrders pending</span>
                </div>
            </div>
            <div class="col-6 col-md-4 col-xl-2">
                <div class="card border-0 shadow-sm p-3 border-start border-danger border-4">
                    <div class="text-muted small text-uppercase">Low Stock</div>
                    <div class="fs-3 fw-bold text-danger">@_lowStockCount</div>
                    <span class="small text-muted">Stock &le; 5 units</span>
                </div>
            </div>
            <div class="col-6 col-md-4 col-xl-2">
                <div class="card border-0 shadow-sm p-3 border-start border-success border-4">
                    <div class="text-muted small text-uppercase">Revenue</div>
                    <div class="fs-3 fw-bold text-success text-truncate">@_stats.TotalSales.ToString("C")</div>
                    <span class="small text-muted">Total orders gross</span>
                </div>
            </div>
        </div>

        <div class="row g-4 mb-4">
            <div class="col-12 col-lg-8">
                <div class="card border-0 shadow-sm mb-4">
                    <div class="card-header bg-transparent fw-bold py-3">
                        <i class="bi bi-grid-3x3-gap-fill me-2 text-primary"></i>Administrator Management Consoles
                    </div>
                    <div class="card-body">
                        <div class="row g-3">
                            <div class="col-12 col-sm-6 col-md-4">
                                <a href="/admin/users" class="btn btn-outline-danger w-100 text-start p-3 h-100">
                                    <div class="fw-bold"><i class="bi bi-shield-person me-2"></i>User &amp; Roles</div>
                                    <div class="small text-muted mt-1">Manage Customer, Staff, and Admin roles</div>
                                </a>
                            </div>
                            <div class="col-12 col-sm-6 col-md-4">
                                <a href="/books" class="btn btn-outline-warning w-100 text-start p-3 h-100">
                                    <div class="fw-bold"><i class="bi bi-journal-bookmark me-2"></i>Book Master</div>
                                    <div class="small text-muted mt-1">Full CRUD on titles, pricing &amp; authors</div>
                                </a>
                            </div>
                            <div class="col-12 col-sm-6 col-md-4">
                                <a href="/staff/orders" class="btn btn-outline-primary w-100 text-start p-3 h-100">
                                    <div class="fw-bold"><i class="bi bi-clipboard-check me-2"></i>Order Oversight</div>
                                    <div class="small text-muted mt-1">View, cancel or transition all customer orders</div>
                                </a>
                            </div>
                            <div class="col-12 col-sm-6 col-md-4">
                                <a href="/authors" class="btn btn-outline-info w-100 text-start p-3 h-100">
                                    <div class="fw-bold"><i class="bi bi-people me-2"></i>Authors CRUD</div>
                                    <div class="small text-muted mt-1">Maintain author profiles &amp; contracts</div>
                                </a>
                            </div>
                            <div class="col-12 col-sm-6 col-md-4">
                                <a href="/publishers" class="btn btn-outline-success w-100 text-start p-3 h-100">
                                    <div class="fw-bold"><i class="bi bi-building me-2"></i>Publishers CRUD</div>
                                    <div class="small text-muted mt-1">Publisher directories and location logs</div>
                                </a>
                            </div>
                            <div class="col-12 col-sm-6 col-md-4">
                                <a href="/swagger" target="_blank" class="btn btn-outline-dark w-100 text-start p-3 h-100">
                                    <div class="fw-bold"><i class="bi bi-code-slash me-2"></i>Swagger Web API</div>
                                    <div class="small text-muted mt-1">Interactive API testing for mobile/REST</div>
                                </a>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="col-12 col-lg-4">
                <div class="card border-0 shadow-sm h-100">
                    <div class="card-header bg-transparent fw-bold py-3">
                        <i class="bi bi-pie-chart-fill me-2 text-info"></i>System Overview
                    </div>
                    <div class="card-body">
                        <ul class="list-group list-group-flush">
                            <li class="list-group-item d-flex justify-content-between px-0">
                                <span class="text-muted">Registered Authors</span>
                                <span class="fw-bold">@_authorCount</span>
                            </li>
                            <li class="list-group-item d-flex justify-content-between px-0">
                                <span class="text-muted">Registered Publishers</span>
                                <span class="fw-bold">@_publisherCount</span>
                            </li>
                            <li class="list-group-item d-flex justify-content-between px-0">
                                <span class="text-muted">Store Sales Records</span>
                                <span class="fw-bold">@_saleCount</span>
                            </li>
                            <li class="list-group-item d-flex justify-content-between px-0">
                                <span class="text-muted">Delivered Orders</span>
                                <span class="fw-bold text-success">@_stats.DeliveredOrders</span>
                            </li>
                        </ul>
                        <div class="mt-4 p-3 bg-light rounded-3 text-muted small">
                            <i class="bi bi-info-circle me-1"></i>Cardiff Met WRIT1 Interactive Mobile Bookstore architecture running on ASP.NET Core 8 &amp; Blazor Server.
                        </div>
                    </div>
                </div>
            </div>
        </div>
    }
}

@code {
    private bool _loading = true;
    private int _authorCount, _publisherCount, _bookCount, _saleCount, _lowStockCount;
    private (int TotalOrders, int PendingOrders, int ProcessingOrders, int ShippedOrders, int DeliveredOrders, decimal TotalSales) _stats;
    private List<BookStoresBlazor.Data.Models.Book> _lowStockBooks = new();
    private List<BookStoresBlazor.Data.Models.AppUser> _allUsers = new();
    private AppUser? _user;

    protected override async Task OnInitializedAsync()
    {
        _user = AuthProvider.GetCurrentUser();

        if (_user?.Role != "Customer")
        {
            _authorCount = await BookService.GetAuthorCountAsync();
            _publisherCount = await BookService.GetPublisherCountAsync();
            _bookCount = await BookService.GetBookCountAsync();
            _saleCount = await BookService.GetSaleCountAsync();
            _lowStockCount = await BookService.GetLowStockCountAsync(5);
            _lowStockBooks = await BookService.GetLowStockBooksAsync(5);
            _stats = await OrderSvc.GetOrderStatsAsync();

            if (_user?.Role == "Admin")
            {
                _allUsers = await OrderSvc.GetAllUsersAsync();
            }
        }

        _loading = false;
    }

    private string GetRoleBadgeClass(string? role) => role switch
    {
        "Admin" => "bg-danger",
        "StoreStaff" => "bg-info text-dark",
        _ => "bg-primary"
    };

    private string GetRoleIcon(string? role) => role switch
    {
        "Admin" => "bi-shield-check",
        "StoreStaff" => "bi-person-badge",
        _ => "bi-person"
    };
}
