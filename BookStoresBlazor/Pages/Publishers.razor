@page "/publishers"
@attribute [Authorize(Roles = "Admin")]
@inject IBookStoresService BookService

<PageTitle>Publishers — BookStores</PageTitle>

<div class="d-flex justify-content-between align-items-center mb-4">
    <div class="d-flex align-items-center">
        <i class="bi bi-building fs-3 me-3 text-success"></i>
        <h2 class="mb-0 fw-bold">Publishers</h2>
    </div>
    <button class="btn btn-success" @onclick="ShowAddForm">
        <i class="bi bi-plus-lg me-1"></i>Add Publisher
    </button>
</div>

@if (_showForm)
{
    <div class="card border-0 shadow-sm mb-4">
        <div class="card-header bg-transparent fw-semibold">
            @(_editPub.PubId == 0 ? "New Publisher" : "Edit Publisher")
        </div>
        <div class="card-body">
            <EditForm Model="@_editPub" OnValidSubmit="SavePublisher">
                <DataAnnotationsValidator />
                <div class="row g-3">
                    <div class="col-md-6">
                        <label class="form-label">Publisher Name <span class="text-danger">*</span></label>
                        <InputText class="form-control" @bind-Value="_editPub.PublisherName" />
                        <ValidationMessage For="() => _editPub.PublisherName" />
                    </div>
                    <div class="col-md-3">
                        <label class="form-label">City</label>
                        <InputText class="form-control" @bind-Value="_editPub.City" />
                    </div>
                    <div class="col-md-1">
                        <label class="form-label">State</label>
                        <InputText class="form-control" @bind-Value="_editPub.State" maxlength="2" />
                    </div>
                    <div class="col-md-2">
                        <label class="form-label">Country</label>
                        <InputText class="form-control" @bind-Value="_editPub.Country" />
                    </div>
                </div>
                <div class="mt-3 d-flex gap-2">
                    <button type="submit" class="btn btn-success" disabled="@_isSaving">
                        @if (_isSaving) { <span class="spinner-border spinner-border-sm me-1"></span> }
                        <i class="bi bi-check-lg me-1"></i>Save
                    </button>
                    <button type="button" class="btn btn-outline-secondary" @onclick="HideForm">
                        <i class="bi bi-x-lg me-1"></i>Cancel
                    </button>
                </div>
            </EditForm>
        </div>
    </div>
}

@if (_publishers is null)
{
    <div class="text-center py-5"><div class="spinner-border text-success" role="status"></div></div>
}
else
{
    <div class="table-responsive">
        <table class="table table-hover table-bordered align-middle">
            <thead class="table-dark">
                <tr>
                    <th>Publisher Name</th>
                    <th>City</th>
                    <th>State</th>
                    <th>Country</th>
                    <th>Books</th>
                    <th style="width:140px;">Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var pub in _publishers)
                {
                    <tr>
                        <td class="fw-semibold">@pub.PublisherName</td>
                        <td>@(pub.City ?? "—")</td>
                        <td>@(pub.State ?? "—")</td>
                        <td>@(pub.Country ?? "—")</td>
                        <td><span class="badge bg-primary">@pub.Books.Count</span></td>
                        <td>
                            <button class="btn btn-sm btn-outline-primary me-1" @onclick="() => EditPublisher(pub)">
                                <i class="bi bi-pencil"></i>
                            </button>
                            <button class="btn btn-sm btn-outline-danger" @onclick="() => DeletePublisher(pub.PubId)">
                                <i class="bi bi-trash"></i>
                            </button>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

@if (!string.IsNullOrEmpty(_message))
{
    <div class="alert alert-@_messageType alert-dismissible mt-3">
        @_message <button type="button" class="btn-close" @onclick="() => _message = string.Empty"></button>
    </div>
}

@code {
    private List<Publisher>? _publishers;
    private Publisher _editPub = new();
    private bool _showForm = false;
    private bool _isSaving = false;
    private string _message = string.Empty;
    private string _messageType = "success";

    protected override async Task OnInitializedAsync() => await LoadPublishers();

    private async Task LoadPublishers()
    {
        _publishers = await BookService.GetPublishersAsync();
        // load with books
        var pubs = new List<Publisher>();
        foreach (var p in _publishers)
        {
            var full = await BookService.GetPublisherAsync(p.PubId);
            if (full is not null) pubs.Add(full);
        }
        _publishers = pubs;
    }

    private void ShowAddForm() { _editPub = new Publisher(); _showForm = true; }
    private void HideForm() { _showForm = false; _editPub = new Publisher(); }

    private void EditPublisher(Publisher pub)
    {
        _editPub = new Publisher { PubId = pub.PubId, PublisherName = pub.PublisherName, City = pub.City, State = pub.State, Country = pub.Country };
        _showForm = true;
    }

    private async Task SavePublisher()
    {
        _isSaving = true;
        try
        {
            if (_editPub.PubId == 0) await BookService.CreatePublisherAsync(_editPub);
            else await BookService.UpdatePublisherAsync(_editPub);
            _message = "Publisher saved!"; _messageType = "success";
            HideForm(); await LoadPublishers();
        }
        catch { _message = "Error saving publisher."; _messageType = "danger"; }
        finally { _isSaving = false; }
    }

    private async Task DeletePublisher(int id)
    {
        try { await BookService.DeletePublisherAsync(id); _message = "Publisher deleted."; _messageType = "warning"; await LoadPublishers(); }
        catch { _message = "Cannot delete — publisher has associated books."; _messageType = "danger"; }
    }
}
