@page "/shop/book/{BookId}"
@attribute [Authorize]
@inject IBookStoresService BookService
@inject CartService CartSvc
@inject WishlistService WishlistSvc
@inject NavigationManager Nav

<PageTitle>@(_book?.Title ?? "Book Detail") — BookStores</PageTitle>

@if (_book is null)
{
    <div class="text-center py-5">
        <div class="spinner-border text-primary" role="status"></div>
    </div>
}
else
{
    <nav aria-label="breadcrumb" class="mb-3">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a href="/shop" class="text-decoration-none">Shop</a></li>
            <li class="breadcrumb-item active text-truncate" style="max-width: 300px;" aria-current="page">@_book.Title</li>
        </ol>
    </nav>

    <div class="row g-4">
        @* ── Book Cover ──────────────────────────────── *@
        <div class="col-12 col-md-4 col-lg-3 text-center">
            <div class="book-cover-large d-flex align-items-center justify-content-center rounded-4 shadow-sm mx-auto"
                 style="width: 100%; max-width: 220px; height: 300px; background: linear-gradient(135deg,#1a1a2e,#0f3460); position: relative;">
                <i class="bi bi-book-half text-white" style="font-size: 5rem; opacity: 0.6;"></i>
                
                @* Wishlist button on cover *@
                <button class="btn btn-sm btn-light rounded-circle position-absolute top-0 end-0 m-2 shadow-sm"
                        title="Toggle Wishlist"
                        @onclick="() => WishlistSvc.Toggle(_book)">
                    <i class="bi @(WishlistSvc.IsInWishlist(_book.BookId) ? "bi-heart-fill text-danger" : "bi-heart text-muted")"></i>
                </button>
            </div>

            <div class="mt-3 d-flex justify-content-center gap-2 flex-wrap">
                <span class="badge bg-secondary">@(_book.Type?.Replace("_", " ") ?? "General")</span>
                @if (_book.Stock > 5)
                {
                    <span class="badge bg-success"><i class="bi bi-check-circle me-1"></i>In Stock (@_book.Stock)</span>
                }
                else if (_book.Stock > 0)
                {
                    <span class="badge bg-warning text-dark"><i class="bi bi-exclamation-triangle me-1"></i>Low Stock (@_book.Stock left)</span>
                }
                else
                {
                    <span class="badge bg-danger"><i class="bi bi-x-circle me-1"></i>Out of Stock</span>
                }
            </div>
        </div>

        @* ── Book Info ───────────────────────────────── *@
        <div class="col-12 col-md-8 col-lg-9">
            <div class="d-flex justify-content-between align-items-start">
                <h2 class="fw-bold mb-1">@_book.Title</h2>
            </div>

            <p class="text-muted mb-2">
                <i class="bi bi-people me-1 text-primary"></i>
                <strong>Author(s):</strong>
                @(string.Join(", ", _book.BookAuthors.Select(ba => ba.Author.FullName)))
            </p>
            <p class="text-muted mb-2">
                <i class="bi bi-building me-1 text-success"></i>
                <strong>Publisher:</strong> @(_book.Publisher?.PublisherName ?? "Independent Publisher")
                @if (_book.Publisher?.City is not null)
                {
                    <span class="ms-1 text-muted small">(@_book.Publisher.City, @_book.Publisher.Country)</span>
                }
            </p>
            @if (_book.PublishDate.HasValue)
            {
                <p class="text-muted mb-3">
                    <i class="bi bi-calendar-event me-1 text-info"></i>
                    <strong>Publication Date:</strong> @_book.PublishDate.Value.ToString("MMMM d, yyyy")
                </p>
            }

            <div class="mb-3 d-flex align-items-baseline gap-3">
                <span class="fs-2 fw-bold text-primary">
                    @(_book.Price.HasValue ? _book.Price.Value.ToString("C") : "Price not available")
                </span>
                <span class="text-muted small">Tax included, free delivery available</span>
            </div>

            @if (!string.IsNullOrEmpty(_book.Description))
            {
                <div class="card border-0 bg-light rounded-3 p-3 mb-4">
                    <h6 class="fw-semibold mb-2"><i class="bi bi-card-text me-2 text-primary"></i>Description &amp; Overview</h6>
                    <p class="mb-0 text-secondary" style="line-height: 1.6;">@_book.Description</p>
                </div>
            }

            @* ── Quantity and Action Controls ─────────── *@
            <div class="d-flex flex-wrap align-items-center gap-3 mb-4">
                @if (_book.Stock > 0 && _book.Price.HasValue)
                {
                    <div class="input-group" style="width: 140px;">
                        <button class="btn btn-outline-secondary" type="button" @onclick="DecrQty" disabled="@(_qty <= 1)">−</button>
                        <input class="form-control text-center fw-bold" type="number" min="1" max="@_book.Stock"
                               @bind="_qty" @bind:event="oninput" />
                        <button class="btn btn-outline-secondary" type="button" @onclick="IncrQty" disabled="@(_qty >= _book.Stock)">+</button>
                    </div>

                    <button class="btn btn-primary px-4 py-2 fw-semibold" @onclick="AddToCart">
                        <i class="bi bi-cart-plus me-2"></i>Add to Cart
                    </button>
                }
                else
                {
                    <button class="btn btn-secondary px-4 py-2 disabled" disabled>
                        <i class="bi bi-slash-circle me-2"></i>Currently Unavailable
                    </button>
                }

                <button class="btn @(WishlistSvc.IsInWishlist(_book.BookId) ? "btn-danger" : "btn-outline-danger") px-3 py-2"
                        @onclick="() => WishlistSvc.Toggle(_book)">
                    <i class="bi @(WishlistSvc.IsInWishlist(_book.BookId) ? "bi-heart-fill me-1" : "bi-heart me-1")"></i>
                    @(WishlistSvc.IsInWishlist(_book.BookId) ? "Saved in Wishlist" : "Save to Wishlist")
                </button>

                <a href="/cart" class="btn btn-outline-success px-3 py-2 ms-auto">
                    <i class="bi bi-cart3 me-1"></i>Cart (@CartSvc.TotalCount)
                </a>
            </div>

            @if (_added)
            {
                <div class="alert alert-success py-2 d-flex align-items-center mb-3">
                    <i class="bi bi-check-circle-fill me-2 fs-5"></i>
                    <div><strong>@_qty item(s)</strong> of "@_book.Title" added to your shopping cart!</div>
                </div>
            }
            @if (!string.IsNullOrEmpty(_errorMessage))
            {
                <div class="alert alert-warning py-2 mb-3">
                    <i class="bi bi-exclamation-triangle-fill me-2"></i>@_errorMessage
                </div>
            }

            @* ── Specs & Metadata Cards ──────────────── *@
            <div class="row g-3">
                <div class="col-6 col-sm-3">
                    <div class="card border-0 bg-light text-center p-3 rounded-3">
                        <div class="fw-bold fs-5 text-success">@_book.Stock</div>
                        <div class="small text-muted">Stock Quantity</div>
                    </div>
                </div>
                <div class="col-6 col-sm-3">
                    <div class="card border-0 bg-light text-center p-3 rounded-3">
                        <div class="fw-bold fs-5 text-primary">@((_book.YtdSales ?? 0).ToString("N0"))</div>
                        <div class="small text-muted">YTD Sales</div>
                    </div>
                </div>
                <div class="col-6 col-sm-3">
                    <div class="card border-0 bg-light text-center p-3 rounded-3">
                        <div class="fw-bold fs-5 text-info">@_book.BookId</div>
                        <div class="small text-muted">ISBN / Book ID</div>
                    </div>
                </div>
                <div class="col-6 col-sm-3">
                    <div class="card border-0 bg-light text-center p-3 rounded-3">
                        <div class="fw-bold fs-5 text-warning">@(_book.Royalty ?? 0)%</div>
                        <div class="small text-muted">Author Royalty</div>
                    </div>
                </div>
                @if (_book.Notes is not null)
                {
                    <div class="col-12">
                        <div class="card border-0 bg-light p-3 rounded-3">
                            <span class="text-muted small"><i class="bi bi-info-circle me-1"></i><strong>Editorial Note:</strong> @_book.Notes</span>
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>
}

@code {
    [Parameter] public string BookId { get; set; } = string.Empty;
    private Book? _book;
    private int _qty = 1;
    private bool _added = false;
    private string _errorMessage = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        _book = await BookService.GetBookAsync(BookId);
    }

    private void IncrQty()
    {
        if (_book != null && _qty < _book.Stock)
            _qty++;
    }

    private void DecrQty()
    {
        if (_qty > 1)
            _qty--;
    }

    private async Task AddToCart()
    {
        if (_book?.Price is null) return;
        if (_book.Stock <= 0)
        {
            _errorMessage = "This title is currently out of stock.";
            return;
        }

        if (_qty > _book.Stock)
        {
            _qty = _book.Stock;
        }

        var success = CartSvc.AddItem(_book.BookId, _book.Title, _book.Price.Value, _qty, _book.Stock);
        if (success)
        {
            _errorMessage = string.Empty;
            _added = true;
            await Task.Delay(2500);
            _added = false;
        }
        else
        {
            _errorMessage = "Could not add requested quantity to cart.";
        }
    }
}
