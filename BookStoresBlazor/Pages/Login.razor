@page "/login"
@layout LoginLayout
@inject IUserService UserService
@inject CustomAuthStateProvider AuthProvider
@inject NavigationManager Nav

<div class="card auth-card shadow-lg border-0">
    <div class="card-body p-4 p-sm-4">
        <div class="text-center mb-3">
            <h4 class="fw-bold mb-1">Welcome Back</h4>
            <p class="text-muted small">Sign in to access your bookstore account</p>
        </div>

        @if (!string.IsNullOrEmpty(_errorMessage))
        {
            <div class="alert alert-danger py-2 px-3 small d-flex align-items-center justify-content-between rounded-3 mb-3">
                <div class="d-flex align-items-center">
                    <i class="bi bi-exclamation-triangle-fill me-2 fs-6"></i>
                    <span>@_errorMessage</span>
                </div>
                <button type="button" class="btn-close btn-close-sm" aria-label="Close" @onclick='() => _errorMessage = string.Empty'></button>
            </div>
        }

        <EditForm Model="@_model" OnValidSubmit="HandleLogin">
            <DataAnnotationsValidator />

            @* Username Field *@
            <div class="mb-3">
                <label class="form-label small fw-semibold text-secondary mb-1">Username or Email</label>
                <div class="input-group">
                    <span class="input-group-text bg-white border-end-0 text-muted">
                        <i class="bi bi-person"></i>
                    </span>
                    <InputText class="form-control border-start-0 ps-0" 
                               @bind-Value="_model.Username" 
                               placeholder="e.g. admin or you@example.com" 
                               disabled="@_isLoading" 
                               autofocus />
                </div>
                <ValidationMessage For="() => _model.Username" class="small text-danger mt-1" />
            </div>

            @* Password Field with Toggle *@
            <div class="mb-3">
                <div class="d-flex justify-content-between align-items-center mb-1">
                    <label class="form-label small fw-semibold text-secondary mb-0">Password</label>
                </div>
                <div class="input-group">
                    <span class="input-group-text bg-white border-end-0 text-muted">
                        <i class="bi bi-lock"></i>
                    </span>
                    <InputText class="form-control border-start-0 border-end-0 ps-0" 
                               type="@(_showPassword ? "text" : "password")" 
                               @bind-Value="_model.Password" 
                               placeholder="Enter your password" 
                               disabled="@_isLoading" />
                    <button class="btn btn-outline-secondary border-start-0 bg-white text-muted" 
                            type="button" 
                            tabindex="-1"
                            title="@(_showPassword ? "Hide password" : "Show password")"
                            @onclick="TogglePasswordVisibility">
                        <i class="bi @(_showPassword ? "bi-eye-slash-fill" : "bi-eye-fill")"></i>
                    </button>
                </div>
                <ValidationMessage For="() => _model.Password" class="small text-danger mt-1" />
            </div>

            @* Sign In Button *@
            <button type="submit" class="btn btn-primary w-100 py-2 fw-semibold rounded-3 mt-2 shadow-sm" disabled="@_isLoading">
                @if (_isLoading)
                {
                    <span class="spinner-border spinner-border-sm me-2" role="status" aria-hidden="true"></span>
                    <span>Verifying...</span>
                }
                else
                {
                    <span>Sign In</span>
                    <i class="bi bi-arrow-right-short ms-1 fs-5 align-middle"></i>
                }
            </button>
        </EditForm>

        <div class="position-relative my-4">
            <hr class="text-muted opacity-25 m-0" />
            <span class="position-absolute top-50 start-50 translate-middle bg-white px-2 text-muted small">or</span>
        </div>

        <div class="text-center">
            <p class="small text-muted mb-2">
                New customer? 
                <a href="/signup" class="fw-bold text-decoration-none text-primary">Create an account</a>
            </p>
            <p class="small mb-0">
                <a href="/shop" class="text-secondary text-decoration-none small">
                    <i class="bi bi-arrow-left me-1"></i>Continue browsing as guest
                </a>
            </p>
        </div>
    </div>
</div>

@code {
    private LoginModel _model = new();
    private string _errorMessage = string.Empty;
    private bool _isLoading = false;
    private bool _showPassword = false;

    [SupplyParameterFromQuery] private string? ReturnUrl { get; set; }

    private void TogglePasswordVisibility()
    {
        _showPassword = !_showPassword;
    }

    private async Task HandleLogin()
    {
        _isLoading = true;
        _errorMessage = string.Empty;

        try
        {
            var user = await UserService.LoginAsync(_model.Username, _model.Password);
            if (user is null)
            {
                _errorMessage = "Invalid username or password. Please check your credentials.";
                _isLoading = false;
                return;
            }

            AuthProvider.Login(user);

            // Redirect to appropriate landing page based on role or ReturnUrl
            if (!string.IsNullOrEmpty(ReturnUrl))
            {
                Nav.NavigateTo(ReturnUrl, forceLoad: false);
            }
            else if (user.Role == "Admin")
            {
                Nav.NavigateTo("/", forceLoad: false);
            }
            else if (user.Role == "StoreStaff")
            {
                Nav.NavigateTo("/staff/orders", forceLoad: false);
            }
            else
            {
                Nav.NavigateTo("/shop", forceLoad: false);
            }
        }
        catch (Exception)
        {
            _errorMessage = "An unexpected error occurred during sign in. Please try again.";
        }
        finally
        {
            _isLoading = false;
        }
    }

    private class LoginModel
    {
        [System.ComponentModel.DataAnnotations.Required(ErrorMessage = "Username or email is required.")]
        public string Username { get; set; } = string.Empty;

        [System.ComponentModel.DataAnnotations.Required(ErrorMessage = "Password is required.")]
        public string Password { get; set; } = string.Empty;
    }
}

